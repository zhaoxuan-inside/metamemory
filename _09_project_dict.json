  "terms": [
    { "term": "域", "code_name": "Domain", "definition": "系统唯一容器实体：个人域=单成员域的事实称呼，组织实例=组织租户；域无类型字段", "aliases": ["个人版系统", "企业版系统", "组织", "租户对象"], "domain": "identity", "related_terms": ["Tenant", "Membership"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "租户", "code_name": "Tenant", "definition": "数据主权硬边界（个人域 1:1 租户；组织实例=组织租户），RLS 根，框架层概念", "aliases": ["数据边界"], "domain": "identity", "related_terms": ["Domain", "TenantCtx"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "视野", "code_name": "Visibility", "definition": "知晓边界档位 L1/L2/L3/L3D/L4/L5——六档=五级+定向变体，读取时裁决的属性", "aliases": ["权限", "可见性开关", "档位光谱"], "domain": "trust", "related_terms": ["AuthorizationRecord", "VisionArbiter"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "视野裁决器", "code_name": "VisionArbiter", "definition": "一切读取路径的唯一裁决入口：粗筛→精裁→目的闸；违反唯一入口=Critical", "aliases": ["权限过滤器", "读路径守卫"], "domain": "trust", "related_terms": ["Visibility", "PurposeGate"], "source": "_06_interface_design/02_internal_interfaces.md" },
    { "term": "授权三元组", "code_name": "AuthorizationRecord", "definition": "授权=视野档位×使用目的×时效；含允许目的集、TTL、状态", "aliases": ["授权记录", "授权三元组记录"], "domain": "trust", "related_terms": ["Visibility", "PurposeScope"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "允许目的集", "code_name": "PurposeScope", "definition": "发布侧声明的允许使用目的集合，公开面裁决谓词（约束 16）", "aliases": ["目的白名单"], "domain": "trust", "related_terms": ["PurposeGate"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "目的闸", "code_name": "PurposeGate", "definition": "L4/L5 检索面按允许目的集×声明目的匹配放行；目的字段是裁决谓词不是记录项", "aliases": ["目的过滤"], "domain": "trust", "related_terms": ["PurposeScope"], "source": "_06_interface_design/02_internal_interfaces.md" },
    { "term": "原文片段", "code_name": "MemoryEpisode", "definition": "情境容器（证据层）：原文+来源+说话人+话题+时间；全量保底永不删除（硬遗忘除外）", "aliases": ["情境容器", "episode", "原文层条目"], "domain": "memory", "related_terms": ["MemoryEntry", "Segment"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "语义原子", "code_name": "MemoryEntry", "definition": "记忆条目（资产层）：{主体,谓词,客体}+双时态+supersedes+引文 span+置信+来源级别+视野+强度", "aliases": ["记忆条目", "原子", "atom", "事实原子"], "domain": "memory", "related_terms": ["MemoryEpisode", "AssociationEdge"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "模式原子", "code_name": "PatternAtom", "definition": "S4 派生的模式陈述：跨期计数+血缘回连（压缩产物）", "aliases": ["模式结论", "画像字段"], "domain": "memory", "related_terms": ["MemoryEntry", "ConsolidationGate"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "关联边", "code_name": "AssociationEdge", "definition": "八类边（实体/时序/情境/替代/语义/因果/派生/冲突）：权重+置信+依据+双时态；血缘=type='derived'", "aliases": ["关系", "边", "链接"], "domain": "memory", "related_terms": ["MemoryEntry"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "引文锚点", "code_name": "AnchorSpan", "definition": "断言在原文中的 span 定位；无引文不记忆的执行载体", "aliases": ["引文", "出处"], "domain": "memory", "related_terms": ["MemoryEntry"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "来源级别", "code_name": "SourceLevel", "definition": "置信来源分级：S1 用户明示 / S2 对话推断 / S3 导入 / S4 二次推理（与交付切片 Slice 同形异义，禁混用）", "aliases": ["来源分级"], "domain": "memory", "related_terms": ["Confidence", "Slice"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "交付切片", "code_name": "Slice", "definition": "交付排期：S0 保底档 / S1 理解闭环 / S2 信任完整 / S3 网络与开发者面（与来源级别 SourceLevel 同形异义，禁混用）", "aliases": ["里程碑切片"], "domain": "process", "related_terms": ["SourceLevel"], "source": "_05_function_design/01_function_matrix.md" },
    { "term": "置信", "code_name": "Confidence", "definition": "来源权重×抽取分×e^(-λ·Δt)；自报分经校准集映射；不采流畅度信号", "aliases": ["置信度", "可信分"], "domain": "memory", "related_terms": ["SourceLevel"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "强度", "code_name": "Strength", "definition": "f(重复,检索,情感)×e^(-λ·Δt)；Δt 于检索命中重置（再巩固窗口）", "aliases": ["记忆强度"], "domain": "memory", "related_terms": ["ReconsolidationWindow"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "单元切分", "code_name": "Segmentation", "definition": "写侧第一决策：从连续流发现记忆单元（对话轮/文档段/事件）；统计信号可归因，span 保底可逆", "aliases": ["切块", "chunking", "分句"], "domain": "memory", "related_terms": ["Segment", "MemoryEpisode"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "切分记录", "code_name": "Segment", "definition": "segment 步骤产物：span+边界依据+切分参数版本，可逆重组", "aliases": ["切分单元"], "domain": "memory", "related_terms": ["Segmentation"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "意图", "code_name": "Intent", "definition": "唯一'有时效、可交易、需确认'的记忆——未来的事；核心层只有字段与状态机位", "aliases": ["需求", "intention"], "domain": "intent", "related_terms": ["IntentRecord", "DiscoverySlot"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "意图发现位", "code_name": "DiscoverySlot", "definition": "'生效中意图进入发现网络的位数'——配额口径（G3）：免费 3 个，Pro 不限；意图本体永远免费不限量", "aliases": ["生效意图数", "意图配额"], "domain": "billing", "related_terms": ["Intent"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "公开条目", "code_name": "PublishedItem", "definition": "发布投影：L4 抽象（生成/发布分离）与 L5 公开；72h 无痕撤回窗", "aliases": ["发布条目"], "domain": "network", "related_terms": ["Visibility"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "弃权", "code_name": "Abstain", "definition": "自动裁决任一级'判不了'的一等合法结论：显式原因码+挂 pipeline_review_queue 人裁；禁默认值兜底", "aliases": ["挂起", "待复核"], "domain": "governance", "related_terms": ["FourWayRoute"], "source": "_03_tech_stack/ADR-003-abstain-first-class.md" },
    { "term": "四态路由", "code_name": "FourWayRoute", "definition": "写入时首次压缩决策：提取/折叠/留原文/abstain", "aliases": ["价值路由"], "domain": "governance", "related_terms": ["Abstain"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "巩固收益门", "code_name": "ConsolidationGate", "definition": "固化入结构化层必须携带泛化收益信号：复用频次×跨情境度×holdout 增益；schema 级抽象过严格门", "aliases": ["收益门"], "domain": "governance", "related_terms": ["PatternAtom"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "再巩固窗口", "code_name": "ReconsolidationWindow", "definition": "检索命中后 72h 内允许 supersedes 重写与衰减重置；窗口外写入走派生门禁", "aliases": ["改写窗口"], "domain": "governance", "related_terms": ["Strength"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "双指标", "code_name": "DualMetrics", "definition": "存储完备率（写侧）与检索召回率（读侧基准对账）分设阈值分开报警，不得互相伪装", "aliases": ["双轨指标"], "domain": "governance", "related_terms": [], "source": "_01_business/02_domain_concepts.md" },
    { "term": "血缘回溯", "code_name": "LineageRecompute", "definition": "纠错沿派生链 BFS 下游 stale 重算；错误不扩散", "aliases": ["级联重算"], "domain": "governance", "related_terms": ["AssociationEdge"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "处理容器", "code_name": "ProcessingContainer", "definition": "方法执行模型：五段执行（提取→操作→拍平→异常策略）；业务只写操作段", "aliases": ["容器", "方法容器"], "domain": "framework", "related_terms": ["DataContract"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "数据契约", "code_name": "DataContract", "definition": "步骤/模型间传版本化 JSON 文档，JSONPath 映射抽取，合同测试进 CI；不传对象不 import 类型", "aliases": ["契约"], "domain": "framework", "related_terms": ["ProcessingContainer"], "source": "_03_tech_stack/ADR-005-data-contract-jsonpath.md" },
    { "term": "流程图", "code_name": "Pipeline", "definition": "版本化有向图定义（六型节点+条件边），数据而非代码；编译期五关校验", "aliases": ["流程", "管道", "编排定义"], "domain": "framework", "related_terms": ["Task"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "任务", "code_name": "Task", "definition": "受理面执行实例：202+task_id，检查点游标=活跃节点集", "aliases": ["作业"], "domain": "framework", "related_terms": ["Pipeline"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "Store 槽位", "code_name": "StoreSlot", "definition": "外部组件接口族 9 槽位；部署档位=槽位预设；允许缺失降级", "aliases": ["组件接口", "存储槽位"], "domain": "framework", "related_terms": ["AntiCorruptionLayer"], "source": "_03_tech_stack/ADR-004-store-slots-degradation.md" },
    { "term": "防腐层", "code_name": "AntiCorruptionLayer", "definition": "一切外部组件唯一访问点：协议翻译/容错/降级/打点；业务禁 import 外部 SDK", "aliases": ["适配器层", "本地封装"], "domain": "framework", "related_terms": ["StoreSlot"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "快通道", "code_name": "FastPath", "definition": "接入事务内同步直写原文层，零 LLM，<100ms 可检索", "aliases": ["同步落袋"], "domain": "framework", "related_terms": ["MemoryEpisode"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "受理语义", "code_name": "AcceptSemantics", "definition": "同步受理返回 task_id+SSE 订阅地址；响应携带'原文已落袋+快通道可检索'确认语义", "aliases": ["202 语义"], "domain": "protocol", "related_terms": ["FastPath"], "source": "_01_business/02_domain_concepts.md" },
    { "term": "认知简报", "code_name": "Brief", "definition": "晨报/周刊：业务层对 search 的定时消费+渲染送达；核心层零简报语义", "aliases": ["简报", "推送"], "domain": "business", "related_terms": [], "source": "_01_business/02_domain_concepts.md" },
    { "term": "检索意图三分", "code_name": "QueryIntent", "definition": "读取质量分层门：事实问答/时点定位/自传检索——是 search 参数不是新 API", "aliases": ["意图分层"], "domain": "protocol", "related_terms": [], "source": "_01_business/02_domain_concepts.md" }
  ]
